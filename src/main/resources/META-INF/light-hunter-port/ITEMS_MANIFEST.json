    },
    {
      "destination": "src/main/java/com/xyp/gtnotgood/common/recipe/machine/LightHunterSpaceStationRecipes.java",
      "sourcePaths": [
        "src/main/java/com/gtladd/gtladditions/data/recipes/NewMultiBlockMachineController.kt",
        "src/main/java/com/gtladd/gtladditions/data/recipes/Misc.kt",
        "src/main/java/com/gtladd/gtladditions/data/recipes/PartMachine.kt"
      ],
      "modifications": "Adapted to GTNH native assembly-line recipes, 19 obtainable casings and existing endgame materials. The station retains 1600000 mB UU-Matter, each factory 16000 mB; the ordinary array retains the original material counts. Existing two-frame Kerr bridge casing converts 1:1 to the distinct four-frame station bridge casing. Native evaporation uses non-cell dehydrator recipes, and three rock-breaking recipes explicitly consume water/lava. No replacement compressed-array production process is added. Detailed mappings are recorded in reference/light-hunter-port/ITEMS_RECIPES.md. Optional native thread modifier hatch recipe retains all original item counts, uses obtainable native endgame components, and rebalances all four mapped fluid quantities to 1/64 (9203125 mB RadoxPolymer, 720000 mB SpaceTime, 1440000 mB Hypogen, 294912000 mB CosmicNeutronium) instead of creating fluid containers. The 1/64 fluid balance does not retain upstream absolute fluid costs.",
      "license": "GPL-3.0-only"
    },
    {
      "destination": "src/main/java/com/xyp/gtnotgood/common/recipe/machine/LightHunterRecipeRules.java",
      "sourcePaths": [
        "src/main/java/com/gtladd/gtladditions/api/machine/logic/GTLAddMultipleRecipesLogic.kt",
